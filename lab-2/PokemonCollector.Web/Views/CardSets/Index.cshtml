@model IReadOnlyList<PokemonCollector.Web.Models.CardSet>
@{
    ViewData["Title"] = "Card Sets";
}

<section class="page-header">
    <h1>Card Set Collection</h1>
    <p class="subtitle">@Model.Count() Pokemon TCG sets available</p>
</section>

<p>
    <a class="btn btn-primary" asp-action="Create">Create new</a>
</p>

<div class="form-inline mb-3">
    <input id="cs-search" class="form-control" placeholder="Search sets..." />
</div>

<div class="card-sets-grid">
    @foreach (var set in Model)
    {
        <div class="card entity-card">
            <div class="card-header">
                <h3>@set.SetName</h3>
                <span class="card-number">@set.SetCode</span>
            </div>
            <div class="card-body">
                <div class="card-meta">
                    <span class="rarity">Released: @set.ReleaseDate.ToString("MMM dd, yyyy")</span>
                    <span class="price">@set.TotalCards cards</span>
                </div>
            </div>
            <div class="card-footer">
                <a class="card-link primary" asp-action="Details" asp-route-id="@set.Id">View Set →</a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function(){
            var input = document.getElementById('cs-search');
            var timeout = null;
            input.addEventListener('input', function(){
                clearTimeout(timeout);
                timeout = setTimeout(function(){
                    var q = encodeURIComponent(input.value || '');
                    fetch('/setovi/search?q=' + q)
                        .then(r => r.json())
                        .then(items => {
                            var grid = document.querySelector('.card-sets-grid');
                            grid.innerHTML = '';
                            items.forEach(function(it){
                                var div = document.createElement('div');
                                div.className = 'card entity-card';
                                div.innerHTML = '<div class="card-header"><h3>'+escapeHtml(it.text)+'</h3></div><div class="card-footer"><a class="card-link primary" href="/setovi/'+it.id+'">View Set →</a></div>';
                                grid.appendChild(div);
                            });
                        });
                }, 300);
            });

            function escapeHtml(text){
                var div = document.createElement('div');
                div.appendChild(document.createTextNode(text));
                return div.innerHTML;
            }
        })();
    </script>
}

@model PokemonCollector.Web.Models.Trade
@{
    ViewData["Title"] = "Delete Trade";
}

<h1>Delete Trade</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Trade</h4>
    <dl class="row">
        <dt class="col-sm-2">Sender</dt>
        <dd class="col-sm-10">@Model.SenderId</dd>
        <dt class="col-sm-2">Receiver</dt>
        <dd class="col-sm-10">@Model.ReceiverId</dd>
        <dt class="col-sm-2">Card Instance</dt>
        <dd class="col-sm-10">@Model.CardInstanceId</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        @Html.AntiForgeryToken()
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>

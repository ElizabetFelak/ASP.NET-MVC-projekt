@model IReadOnlyList<User>
@{
    ViewData["Title"] = "Users";
}

    <section class="page-header">
        <h1>Trainer Registry</h1>
        <p class="subtitle">@Model.Count() Pokemon collectors registered</p>
    </section>

    <div class="users-grid">
        @foreach (var user in Model)
        {
            <div class="card entity-card">
                <div class="card-header">
                    <h3>@user.Username</h3>
                    <span class="status-badge status-active">Trainer</span>
                </div>
                <div class="card-body">
                    <div class="card-meta">
                        <span class="rarity">@user.Email</span>
                        <span class="price">Budget: @user.Budget.ToString("C")</span>
                        <span>Collections: @user.Collections.Count</span>
                        <span class="rarity">Joined: @user.RegistrationDate.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>
                <div class="card-footer">
                    <a class="card-link primary" asp-action="Details" asp-route-id="@user.Id">View Profile →</a>
                </div>
            </div>
        }
    </div>

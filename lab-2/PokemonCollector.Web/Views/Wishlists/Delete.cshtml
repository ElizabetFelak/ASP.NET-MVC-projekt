@model PokemonCollector.Web.Models.Wishlist
@{
    ViewData["Title"] = "Delete Wishlist Item";
}

<h1>Delete Wishlist Item</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Wishlist Item</h4>
    <dl class="row">
        <dt class="col-sm-2">User</dt>
        <dd class="col-sm-10">@Model.UserId</dd>
        <dt class="col-sm-2">Card</dt>
        <dd class="col-sm-10">@Model.PokemonCardId</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        @Html.AntiForgeryToken()
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>

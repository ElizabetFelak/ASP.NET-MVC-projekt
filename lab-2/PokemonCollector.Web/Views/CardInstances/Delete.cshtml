@model PokemonCollector.Web.Models.CardInstance
@{
    ViewData["Title"] = "Delete Card Instance";
}

<h1>Delete Card Instance</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Card Instance</h4>
    <dl class="row">
        <dt class="col-sm-2">Card</dt>
        <dd class="col-sm-10">@Model.PokemonCardId</dd>
        <dt class="col-sm-2">Collection</dt>
        <dd class="col-sm-10">@Model.CollectionId</dd>
        <dt class="col-sm-2">Quantity</dt>
        <dd class="col-sm-10">@Model.Quantity</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        @Html.AntiForgeryToken()
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>

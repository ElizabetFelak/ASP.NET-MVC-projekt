@model PokemonCard
@{
    ViewData["Title"] = "Delete Pokemon Card";
}

<h1>Delete Pokemon Card</h1>

<h3>Are you sure you want to delete this card?</h3>

<div>
    <h4>@Model.CardName</h4>
    <dl class="row">
        <dt class="col-sm-2">Pokedex #</dt>
        <dd class="col-sm-10">@Model.PokemonNumber</dd>
        <dt class="col-sm-2">Type</dt>
        <dd class="col-sm-10">@Model.Type</dd>
        <dt class="col-sm-2">Rarity</dt>
        <dd class="col-sm-10">@Model.Rarity</dd>
        <dt class="col-sm-2">Market Price</dt>
        <dd class="col-sm-10">@Model.MarketPrice.ToString("C")</dd>
        @if (Model.CardSet != null)
        {
            <dt class="col-sm-2">Card Set</dt>
            <dd class="col-sm-10">@Model.CardSet.SetName</dd>
        }
    </dl>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="text-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        @Html.AntiForgeryToken()
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
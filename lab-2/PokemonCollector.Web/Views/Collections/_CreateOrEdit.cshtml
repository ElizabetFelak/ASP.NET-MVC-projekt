@model PokemonCollector.Web.Models.Collection

<div class="form-group">
    <label asp-for="CollectionName" class="control-label"></label>
    <input asp-for="CollectionName" class="form-control" />
    <span asp-validation-for="CollectionName" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="UserId" class="control-label"></label>
    <select asp-for="UserId" class="form-control">
        <option value="">-- Select a User --</option>
        @foreach (var user in (List<PokemonCollector.Web.Models.User>)ViewBag.Users)
        {
            <option value="@user.Id">@user.Username (@user.Email)</option>
        }
    </select>
    <span asp-validation-for="UserId" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="CreatedDate" class="control-label"></label>
    @{ ViewData["FieldName"] = "CreatedDate"; ViewData["Value"] = Model?.CreatedDate; }
    @await Html.PartialAsync("_DateTimePicker")
    <span asp-validation-for="CreatedDate" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="CollectionValue" class="control-label"></label>
    <input asp-for="CollectionValue" class="form-control" />
    <span asp-validation-for="CollectionValue" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Description" class="control-label"></label>
    <textarea asp-for="Description" class="form-control"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="form-group form-check">
    <input asp-for="IsPublic" class="form-check-input" />
    <label asp-for="IsPublic" class="form-check-label"></label>
</div>

<div class="form-group">
    <input type="submit" value="Save" class="btn btn-primary" />
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>

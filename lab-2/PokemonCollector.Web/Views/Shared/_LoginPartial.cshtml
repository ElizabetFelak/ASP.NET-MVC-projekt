@using Microsoft.AspNetCore.Identity
@using PokemonCollector.Web.Models

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<div class="login-partial">
@if (SignInManager.IsSignedIn(User))
{
    <span class="user-name">Hello @User.Identity?.Name!</span>
    <form class="logout-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="nav-link">Logout</button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Register" class="nav-link">Register</a>
    <a asp-area="Identity" asp-page="/Account/Login" class="nav-link">Login</a>
}

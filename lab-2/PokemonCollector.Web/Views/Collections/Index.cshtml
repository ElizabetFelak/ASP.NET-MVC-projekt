@model IReadOnlyList<Collection>
@{
    ViewData["Title"] = "Collections";
}

<section class="page-header">
    <h1>Collection Radar</h1>
    <p class="subtitle">@Model.Count() collections tracked</p>
</section>

<p>
    <a class="btn btn-primary" asp-action="Create">Create new</a>
</p>

<div class="form-inline mb-3">
    <input id="collections-search" class="form-control" placeholder="Search collections..." />
</div>

<div class="collections-grid">
    @foreach (var collection in Model)
    {
        <div class="card entity-card">
            <div class="card-header">
                <h3>@collection.CollectionName</h3>
                <span class="status-badge @(collection.IsPublic ? "status-active" : "status-pending")">@(collection.IsPublic ? "Public" : "Private")</span>
            </div>
            <div class="card-body">
                <div class="card-meta">
                    @if (collection.User != null)
                    {
                        <span>
                            Owner: 
                            <a class="inline-link" asp-controller="Users" asp-action="Details" asp-route-id="@collection.User.Id">@collection.User.Username</a>
                        </span>
                    }
                    <span class="price">@collection.CollectionValue.ToString("C")</span>
                    <span class="rarity">Created: @collection.CreatedDate.ToString("MMM dd, yyyy")</span>
                </div>
            </div>
            <div class="card-footer">
                <a class="card-link primary" asp-action="Details" asp-route-id="@collection.Id">View Collection →</a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        initAjaxSearch({
            inputSelector: '#collections-search',
            gridSelector: '.collections-grid',
            searchUrl: '/kolekcije/search',
            renderItem: function (item) {
                var badgeClass = item.isPublic ? 'status-active' : 'status-pending';
                var label = item.isPublic ? 'Public' : 'Private';
                return '<div class="card entity-card">' +
                    '<div class="card-header"><h3>' + escapeHtml(item.collectionName) + '</h3><span class="status-badge ' + badgeClass + '">' + label + '</span></div>' +
                    '<div class="card-body"><div class="card-meta">' +
                    (item.ownerName ? '<span>Owner: <a class="inline-link" href="/Users/' + item.id + '">' + escapeHtml(item.ownerName) + '</a></span>' : '') +
                    '<span class="price">' + formatCurrency(item.collectionValue) + '</span>' +
                    '<span class="rarity">Created: ' + formatDate(item.createdDate) + '</span>' +
                    '</div></div>' +
                    '<div class="card-footer"><a class="card-link primary" href="/kolekcije/' + item.id + '">View Collection →</a></div>' +
                    '</div>';
            }
        });

        function escapeHtml(text) { var div = document.createElement('div'); div.appendChild(document.createTextNode(text || '')); return div.innerHTML; }
        function formatCurrency(value) { return new Intl.NumberFormat(undefined, { style: 'currency', currency: 'USD' }).format(value || 0); }
        function formatDate(value) { return new Date(value).toLocaleDateString(); }
    </script>
}
